# ============================================================
# .htaccess - PT Andalan Beton (REVISI FINAL ANTI-REDIRECT)
# ============================================================

# Paksa server membaca index.php sebagai halaman utama
DirectoryIndex index.php

Options -Indexes
ServerSignature Off

# ── 1. ROUTING & SECURITY RULES ─────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Jika akses root domain (andalanbeton.com atau /), paksa HANYA jalankan index.php
    RewriteRule ^$ index.php [L]

    # Block direct access ke folder internal sensitif
    RewriteRule ^config/ - [F,L]
    RewriteRule ^database/ - [F,L]
    RewriteRule ^includes/ - [F,L]
    RewriteRule ^vendor/ - [F,L]
</IfModule>

# ── 2. CEGAH BROWSER MENYIMPAN REDIRECT LAMA (NO-CACHE HTML) ─
<IfModule mod_headers.c>
    # Unset header Location bekas redirect lama jika ada
    Header unset Location
</IfModule>

# Matikan cache KHUSUS untuk Dokumen PHP/HTML agar selalu Ambil Versi Baru dari Server
<FilesMatch "\.(php|html)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate, private"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</FilesMatch>

# ── 3. CACHE HANYA UNTUK ASET STATIS (CSS, JS, GAMBAR) ────────
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|ico|woff2|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ── 4. COMPRESSION ──────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml
</IfModule>

# ── 5. SECURITY HEADERS ─────────────────────────────────────
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── 6. PHP SETTINGS ─────────────────────────────────────────
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 60
</IfModule>